{
    "name": "mvplounge/meshfactory",
    "description": "Meshu® Labs | MVP Lounge - DOM Element Factory for PHP.",
    "type": "library",
    "version": "1.0.0-dev",
    "time": "2026-05-27",
    "license": "GPL-3.0-or-later",
    "keywords": [
        "php",
        "meshu",
        "meshu labs",
        "factory UI"
    ],
    "homepage": "https://start.meshu.us",
    "authors": [
        {
            "name": "Lawrence Ball",
            "email": "lball@meshu.us",
            "homepage": "https://www.larryeball.com",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "info@meshu.us"
    },
    "source": {
        "type": "git",
        "url": "https://github.com/mvplounge/meshfactory.git",
        "reference": "main"
    },
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "MvpLounge\\MeshFactory\\": "src/MvpLounge/MeshFactory/"
        },
        "classmap": [
            "src/MvpLounge/MeshFactory/"
        ],
        "exclude-from-classmap": [
            ".instructions.md",
            "/AGENTS.md",
            "/docs/",
            "/sandbox/"
        ]
    },
    "archive": {
        "exclude": [
            "/*",
            "!/README.md",
            "!/src/",
            "/src/*",
            "!/src/MvpLounge/",
            "/src/MvpLounge/*",
            "!/src/MvpLounge/MeshFactory/",
            "!/src/MvpLounge/MeshFactory/**"
        ]
    },
    "config": {
        "sort-packages": true
    }
}